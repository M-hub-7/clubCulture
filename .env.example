# Copier en .env puis renseigner. Ne jamais commiter .env.

# Base PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:motdepasse@localhost:5432/clubculture"

# Signature des jetons de session (connexion) — chaîne aléatoire longue
NEXTAUTH_SECRET=""
# Signature des QR codes des billets — différente de NEXTAUTH_SECRET
JWT_SECRET=""
# Clé demandée par /setup-admin pour créer le premier administrateur
ADMIN_SECRET=""
# Bearer attendu par /api/cron/expirer-reservations (Vercel Cron l'envoie automatiquement)
CRON_SECRET=""

# Stripe (clés de test sk_test_ / pk_test_ en développement)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# E-mails (réinitialisation du mot de passe)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# URL publique de l'application (liens dans les e-mails)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tests d'intégration uniquement : autorise le vidage de la base DATABASE_URL
# TEST_DB_RESET=1
